# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Your Telegram chat id (write /start to your bot once, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id)
TELEGRAM_CHAT_ID=00000000

# Your claude.ai organization UUID (visible in the usage API URL / browser devtools)
CLAUDE_ORG_ID=00000000-0000-0000-0000-000000000000

# SMTP settings for the email alert (example: mail.ru; adjust host/port for your provider)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
EMAIL_USER=you@example.com

# App-specific SMTP password (NOT your regular account password)
SMTP_SPECIAL_PASS=change-me

# How often `monitor.py --loop` re-checks, in minutes
CHECK_INTERVAL_MINUTES=10

# Utilization drop (percentage points) that counts as a suspicious mid-week reset
DROP_THRESHOLD=1.0
